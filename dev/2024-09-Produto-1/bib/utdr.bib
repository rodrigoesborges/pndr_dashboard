@Article{cardozoPoliticasEstaduaisAtracao2011,
  AUTHOR = {Cardozo, Soraia Aparecida},
  JOURNAL = {Revista Econ{\^o}mica do Nordeste},
  NUMBER = {3},
  PAGES = {641--660},
  TITLE = {{Pol{\'i}ticas Estaduais de Atra{\c c}{\~a}o de Investimentos Baseadas em Isen{\c c}{\~a}o Fiscal: Uma An{\'a}lise do Estado do Cear{\'a} de 1995 a 2008}},
  VOLUME = {42},
