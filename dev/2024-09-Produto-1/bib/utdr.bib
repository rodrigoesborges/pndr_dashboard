@Article{delgadoDesenvolvimentoTerritorialArticulacao2007,
  AUTHOR = {Delgado, Nelson Giordano and Bonnal, Philippe and Leite, S{\'e}rgio Pereira and de Janeiro (UFRRJ), Universidade Federal Rural do Rio},
  MONTH = {},
  PUBLISHER = {Observat{\'o}rio de Pol{\'i}ticas P{\'u}blicas para a Agricultura (OPPA)},
  TITLE = {Desenvolvimento Territorial : Articula{\c c}{\~a}o de Pol{\'i}ticas P{\'u}blicas e Atores Sociais},
  YEAR = {2007},
  URLDATE = {2024-09-04},
  FILE = {/home/rodrigo/Zotero/storage/SFN4YMF6/Delgado et al. - 2007 - Desenvolvimento territorial articulação de políticas públicas e atores sociais.pdf},
  ABSTRACT = {O tema do desenvolvimento territorial no Brasil, em especial nos espa{\c c}os rurais, tem sido objeto de um n{\'u}mero crescente de estudos e interven{\c c}{\~o}es pol{\'i}ticas. Em novembro de 2003, o Instituto Interamericano de Coopera{\c c}{\~a}o para a Agricultura (IICA) tomou a iniciativa de organizar um semin{\'a}rio intitulado ``Territ{\'o}rio, desenvolvimento rural e democracia`` (IICA, 2003), cujos resultados constitu{\'i}ram- se num relativo brainstorming dedicado ao assunto, rebatendo, inclusive, na arma{\c c}{\~a}o do contexto institucional de pol{\'i}ticas p{\'u}blicas no n{\'i}vel do governo federal, que se encontrava {\`a} {\'e}poca em processo de constru{\c c}{\~a}o. Passados quatro anos, e com uma rica e complexa experi{\^e}ncia n{\~a}o limitada ao meio rural, novas investidas sobre o assunto est{\~a}o em curso, entre as quais o presente estudo voltado a explorar as interfaces entre desenvolvimento territorial, pol{\'i}ticas p{\'u}blicas e atores sociais. Para a elabora{\c c}{\~a}o deste texto, foi realizado um amplo levantamento bibliogr{\'a}fico e documental sobre o tema, em particular valendo-se da literatura dedicada ao caso brasileiro sem comprometer, contudo, refer{\^e}ncias internacionais quando necess{\'a}rio. O material recolhido nesse processo foi sistematizado pela equipe de pesquisadores, procurando dar conta n{\~a}o somente das an{\'a}lises sobre o meio rural, mas incorporando igualmente outros textos cujo objeto n{\~a}o se referia propriamente ao tema agr{\'a}rio. No sentido de complementar o tratamento dispensado ao assunto, incorporou-se, tamb{\'e}m, o debate travado no f{\'o}rum virtual de discuss{\~o}es sobre ``Pol{\'i}ticas p{\'u}blicas e atores sociais'', sediado na p{\'a}gina internet do F{\'o}rum Permanente de Desenvolvimento Rural Sustent{\'a}vel (F{\'o}rum DRS), al{\'e}m da consulta ao material de entrevistas e depoimentos com representantes do poder p{\'u}blico e organiza{\c c}{\~o}es da sociedade civil constantes no acervo de estudos anteriores desenvolvidos pelos membros da equipe.},
  LANGID = {american},
  KEYWORDS = {No DOI found},
