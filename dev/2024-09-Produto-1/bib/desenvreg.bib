@article{cardozoPoliticasEstaduaisAtracao2011,
  title = {{Pol{\'i}ticas Estaduais de Atra{\c c}{\~a}o de Investimentos Baseadas em Isen{\c c}{\~a}o Fiscal: Uma An{\'a}lise do Estado do Cear{\'a} de 1995 a 2008}},
  shorttitle = {{Pol{\'i}ticas Estaduais de Atra{\c c}{\~a}o de Investimentos Baseadas em Isen{\c c}{\~a}o Fiscal}},
  author = {Cardozo, Soraia Aparecida},
  year = {2011},
  journal = {Revista Econ{\^o}mica do Nordeste},
  volume = {42},
  number = {3},
  pages = {641--660},
  issn = {2357-9226},
  doi = {10.61673/ren.2011.165},
  urldate = {2024-09-07},
  abstract = {Este artigo tem o intuito de responder {\`a}s seguintes~quest{\~o}es: diante do desmantelamento das pol{\'i}ticas~nacionais que tinham como objetivo o desenvolvimento~regional e a supera{\c c}{\~a}o das heterogeneidades~regionais, qual {\'e} a capacidade dos incentivos fiscais e~financeiros estaduais alterarem a divis{\~a}o inter-regional~do trabalho e mudar especializa{\c c}{\~o}es produtivas~regionais? Os incentivos fiscais necessariamente~mudam a participa{\c c}{\~a}o da atividade industrial estadual~na produ{\c c}{\~a}o nacional? Guardam rela{\c c}{\~a}o direta com~as altera{\c c}{\~o}es nas estruturas produtivas estaduais?~Os dados que subsidiaram a an{\'a}lise ilustram que~os incentivos fiscais no Estado do Cear{\'a} n{\~a}o~necessariamente contribu{\'i}ram para a desconcentra{\c c}{\~a}o~regional da atividade industrial e, al{\'e}m disso, muitas~atividades que foram contempladas pelos incentivos~fiscais e apresentaram desconcentra{\c c}{\~a}o espacial foram~influenciadas tamb{\'e}m, em grande medida, por outros~condicionantes, situa{\c c}{\~a}o verificada principalmente para~as atividades produtoras de Bens de Consumo N{\~a}o~Dur{\'a}veis. Mostra que a pol{\'i}tica de atra{\c c}{\~a}o de empresas~do Estado do Cear{\'a}, desde os anos 1990, n{\~a}o foi capaz~de modificar a participa{\c c}{\~a}o do estado no Valor da~Transforma{\c c}{\~a}o Industrial, nem de promover mudan{\c c}as~significativas na estrutura produtiva estadual no sentido~de uma maior diversifica{\c c}{\~a}o e maior complexidade de~sua estrutura industrial.},
  copyright = {Copyright (c) 2016 Revista Econ{\^o}mica do Nordeste},
  langid = {portuguese},
  keywords = {/unread,Guerra Fiscal. Desenvolvimento Nacional. Desenvolvimento Regional. Desenvolvimento Local. Federalismo.},
  annotation = {GSCC: 0000009},
  file = {/home/rodrigo/Zotero/storage/Y7RFPJH4/Cardozo - 2011 - Políticas Estaduais de Atração de Investimentos Baseadas em Isenção Fiscal Uma Análise do Estado do.pdf}
}

