  urldate = {2024-09-06},
  abstract = {Resumo 					O artigo indaga sobre a exist{\^e}ncia de um Projeto Nacional de Desenvolvimento (PND) no governo de Luiz In{\'a}cio Lula da Silva (2003-2010). O conceito de Projeto Nacional de Desenvolvimento {\'e} abordado antes da discuss{\~a}o da bibliografia sobre o governo Lula e do material emp{\'i}rico que sustenta a interpreta{\c c}{\~a}o proposta, segundo a qual o governo Lula tinha um PND com o intuito de superar o subdesenvolvimento a longo prazo. Por meio de programas e pol{\'i}ticas p{\'u}blicas, procurou implementar ideias apresentadas coerentemente antes e durante o mandato presidencial. Argumentamos que a hip{\'o}tese n{\~a}o {\'e} refutada nem pela exist{\^e}ncia de incoer{\^e}ncia relativa na pol{\'i}tica macroecon{\^o}mica, dificuldades de implementa{\c c}{\~a}o de ordem diversa e resultados que combinaram sucessos e insucessos, sem alcan{\c c}ar plenamente os objetivos delineados. Defendemos que o subtipo de desenvolvimentismo perseguido era o social-desenvolvimentismo, buscando combinar a expans{\~a}o do mercado interno de massas por interm{\'e}dio de pol{\'i}ticas de crescimento do emprego, dos sal{\'a}rios e da inclus{\~a}o social, com pol{\'i}ticas orientadas para o apoio ao investimento p{\'u}blico e privado e {\`a} supera{\c c}{\~a}o de restri{\c c}{\~o}es de balan{\c c}o de pagamentos. Finalmente, discutimos criticamente interpreta{\c c}{\~o}es que negam a exist{\^e}ncia de um Projeto Nacional de Desenvolvimento no governo Lula, antes de sugerir raz{\~o}es estruturais porque ele n{\~a}o alcan{\c c}ou seu objetivo maior.},
  copyright = {Copyright (c) 2024  Princ{\'i}pios},
  langid = {portuguese},
  keywords = {desenvolvimentismo,governo Lula,novo-desenvolvimentismo,projeto nacional de desenvolvimento,social-desenvolvimentismo},
  annotation = {GSCC: 0000000},
  file = {/home/rodrigo/Zotero/storage/Z6L3TBA4/Moreira e Bastos - 2023 - O Projeto Nacional de Desenvolvimento no governo Lula (2003-2010).pdf}
}

