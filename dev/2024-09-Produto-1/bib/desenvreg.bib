@incollection{portugalEntreUrbanoRegional2024,
  title = {{Entre o urbano e o regional: as metr{\'o}poles e os fundos constitucionais de financiamento}},
  booktitle = {{50 Anos de regi{\~o}es metropolitanas no Brasil e a Pol{\'i}tica Nacional de Desenvolvimento Urbano : no cen{\'a}rio de adapta{\c c}{\~a}o das cidades {\`a}s mudan{\c c}as clim{\'a}ticas e {\`a} transi{\c c}{\~a}o digital}},
  editor = {Portugal, Rodrigo},
  year = {2024},
  month = mar,
  publisher = {Ipea},
  doi = {10.38116/978-65-5635-068-4},
  urldate = {2024-09-02},
  abstract = {O sexto livro da s{\'e}rie Governan{\c c}a Metropolitana no Brasil re{\'u}ne contribui{\c c}{\~o}es que buscam refletir a efem{\'e}ride dos 50 anos da cria{\c c}{\~a}o das primeiras regi{\~o}es metropolitanas no pa{\'i}s no contexto de constru{\c c}{\~a}o da Pol{\'i}tica Nacional de Desenvolvimento Urbano, resultado de um Termo de Execu{\c c}{\~a}o Descentralizada cujo aditivo foi celebrado com o Minist{\'e}rio das Cidades. Dividida em tr{\^e}s eixos tem{\'a}ticos, a publica{\c c}{\~a}o traz entrevistas e artigos que contribuem para entender a quest{\~a}o urbana do pa{\'i}s em perspectiva hist{\'o}rica, mas atenta para os desafios contempor{\^a}neos. A primeira parte do livro aborda a trajet{\'o}ria da agenda metropolitana no pa{\'i}s em suas rela{\c c}{\~o}es com a reforma urbana, com destaque para a necessidade de um olhar voltado {\`a} diversidade socioespacial do pa{\'i}s. A segunda parte trata dos desafios associados ao financiamento metropolitano e {\`a} quest{\~a}o da governan{\c c}a interfederativa, com vis{\~o}es que permitem refletir sobre os caminhos para superar os conflitos horizontais e verticais do federalismo tripartite brasileiro. Por fim, a terceira parte do livro aborda temas transversais ao desenvolvimento urbano/metropolitano, a saber, as mudan{\c c}as clim{\'a}ticas e a transforma{\c c}{\~a}o digital, os quais se colocam como indispens{\'a}veis para qualquer reflex{\~a}o sobre os rumos do planejamento e da governan{\c c}a metropolitana no pa{\'i}s. Em um contexto marcado por desafios que demandam de forma veemente a constru{\c c}{\~a}o de pol{\'i}ticas urbanas efetivas, espera-se que a publica{\c c}{\~a}o dos aportes aqui reunidos seja, de fato, um subs{\'i}dio para que se desenhem e se implementem pol{\'i}ticas p{\'u}blicas que contribuam para cidades brasileiras mais justas, solid{\'a}rias e sustent{\'a}veis.},
  isbn = {9786556350684},
  langid = {portuguese},
  annotation = {GSCC: 0000001},
  file = {/home/rodrigo/Zotero/storage/UZ8WML2J/Portugal - 2024 - Entre o urbano e o regional as metrópoles e os fundos constitucionais de financiamento.pdf}
}

@article{quaglioQuestaoRegionalBNDES2017,
  title = {{A quest{\~a}o regional e o BNDES: uma an{\'a}lise da conformidade entre a atua{\c c}{\~a}o do Banco e a Pol{\'i}tica Nacional de Desenvolvimento Regional (PNDR)}},
  shorttitle = {{A quest{\~a}o regional e o BNDES}},
  author = {Quaglio, Gislaine de Miranda and de Paiva, Cl{\'a}udio Cesar},
  year = {2017},
  month = nov,
  journal = {Economia e Sociedade},
  volume = {26},
  number = {2},
  pages = {337--368},
  issn = {1982-3533},
  doi = {10.1590/1982-3533.2017v26n2art3},
  urldate = {2024-09-07},
  abstract = {O objetivo deste artigo {\'e} analisar a conformidade entre a atua{\c c}{\~a}o do BNDES, linhas de financiamento e desembolsos, e as estrat{\'e}gias de redu{\c c}{\~a}o das desigualdades regionais propostas no {\^a}mbito da Pol{\'i}tica Nacional de Desenvolvimento Regional (PNDR). Procura-se identificar se a distribui{\c c}{\~a}o das opera{\c c}{\~o}es de cr{\'e}dito do Banco, no per{\'i}odo de 2007 a 2012, alcan{\c c}ou as regi{\~o}es menos desenvolvidas, priorizadas pela Pol{\'i}tica. Os resultados encontrados demonstraram que a atua{\c c}{\~a}o do BNDES se compatibilizou com a din{\^a}mica regional caracter{\'i}stica do per{\'i}odo p{\'o}s 1980, ou seja, pela fragmenta{\c c}{\~a}o e reconcentra{\c c}{\~a}o regional das opera{\c c}{\~o}es realizadas. A desconcentra{\c c}{\~a}o econ{\^o}mica e social no Brasil depende da efetividade com que a l{\'o}gica do desenvolvimento regional {\'e} adotada e operacionalizada pelos agentes envolvidos. No caso do BNDES essa efetividade compreende n{\~a}o apenas o discurso de ado{\c c}{\~a}o da tipologia microrregional trazida pela PNDR, mas tamb{\'e}m uma atua{\c c}{\~a}o ativa nas regi{\~o}es que necessitam estimular suas potencialidades locais.},
  copyright = {Copyright (c) 2017 Economia e Sociedade},
  langid = {portuguese},
  keywords = {/unread,PNDR. BNDES. Economia regional. Questao regional. Politica regional.},
  annotation = {GSCC: 0000011},
  file = {/home/rodrigo/Zotero/storage/BR9WVGHQ/Quaglio e Paiva - 2017 - A questão regional e o BNDES uma análise da conformidade entre a atuação do Banco e a Política Naci.pdf}
}

