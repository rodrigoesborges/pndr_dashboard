@article{souzaDesafiosGovernoLula2023a,
  title = {{Desafios do governo Lula:}},
  shorttitle = {{Desafios do governo Lula}},
  author = {de Souza, Nilson Ara{\'u}jo},
  year = {2023},
  journal = {Princ{\'i}pios},
  volume = {42},
  number = {168},
  pages = {127--151},
  issn = {2675-6609},
  doi = {10.4322/principios.2675-6609.2023.168.007},
  urldate = {2024-09-06},
  abstract = {Resumo 					Este ensaio tem o objetivo de resgatar as principais contribui{\c c}{\~o}es apresentadas no Semin{\'a}rio ``100+50: desafios do governo Lula'', cujo prop{\'o}sito era diagnosticar os desafios do atual governo. A principal caracter{\'i}stica desse momento {\'e} o fato de que, havendo derrotado nas urnas a extrema direita de car{\'a}ter fascista que governava o pa{\'i}s, o desafio do governo Lula, para continuar reconstruindo e preservando a democracia, {\'e} implementar a reconstru{\c c}{\~a}o nacional. As contribui{\c c}{\~o}es aportadas no semin{\'a}rio podem ser {\'u}teis para travar a luta de ideias e subsidiar a defini{\c c}{\~a}o/implementa{\c c}{\~a}o de pol{\'i}ticas que ajudem a tirar o pa{\'i}s da crise. Para condensar e sistematizar as principais contribui{\c c}{\~o}es, adota-se um eixo metodol{\'o}gico que consiste em interferir o m{\'i}nimo poss{\'i}vel nas exposi{\c c}{\~o}es e na postura anal{\'i}tica dos palestrantes. Procura-se deixar o palestrante ``falar'' no texto, sem abrir m{\~a}o de uma postura anal{\'i}tica. Ao mesmo tempo que se buscam os pontos convergentes, deixa-se espa{\c c}o para a controv{\'e}rsia. Convidaram-se economistas e l{\'i}deres sindicais e estudantis com aprecia{\c c}{\~o}es pr{\'o}prias e diferenciadas da pol{\'i}tica econ{\^o}mica do governo. Uma conclus{\~a}o fundamental foi a de que o principal entrave conjuntural para o governo Lula vencer o seu desafio mais importante {\'e} a elevada taxa de juros praticada pelo Banco Central. Destacamos tr{\^e}s temas presentes no semin{\'a}rio: 1) O Brasil na crise e na transi{\c c}{\~a}o geopol{\'i}tica; 2) O desafio da reconstru{\c c}{\~a}o nacional do governo Lula; 3) Entraves ao crescimento econ{\^o}mico; 4) O arcabou{\c c}o fiscal/novo marco fiscal e o investimento.},
  copyright = {Copyright (c) 2024  Princ{\'i}pios},
  langid = {portuguese},
  keywords = {projeto nacional de desenvolvimento,reconstrucao nacional,taxas de juros},
  annotation = {GSCC: 0000004},
  file = {/home/rodrigo/Zotero/storage/RWPMYRYM/Souza - 2023 - Desafios do governo Lula.pdf}
}

