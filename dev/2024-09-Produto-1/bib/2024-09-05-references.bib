  author = {family=Macedo, given=Fernando Cezar, prefix=de, useprefix=false and Porto, Leonardo Rodrigues},
  date = {2018-09},
  journaltitle = {http://www.ipea.gov.br},
  shortjournal = {Texto para Discussão (TD) 2414 : Proposta de atualização das tipologias da PNDR : nota metodológica e mapas de referência},
  publisher = {Instituto de Pesquisa Econômica Aplicada (Ipea)},
  url = {https://repositorio.ipea.gov.br/handle/11058/8703},
  urldate = {2024-09-05},
  abstract = {Este texto para discussão analisa a Política Nacional de Desenvolvimento Regional (PNDR) que completou, em 2017, dez anos de sua institucionalização. O estudo discute esta política a partir de suas premissas básicas e de sua concepção teórica. Aponta ainda as dificuldades para sua implementação nos marcos da Federação brasileira e nos limites de atuação do Estado, especialmente pela ausência de um projeto nacional de desenvolvimento. Na segunda metade, faz-se uma atualização dos parâmetros da tipologia sub-regional da PNDR, baseada no levantamento de dados mais recentes disponíveis. Segue-se a metodologia adotada para a classificação das microrregiões (MRGs) do Instituto Brasileiro de Geografia e Estatística (IBGE), apresentada na versão original da política, institucionalizada pelo Decreto nº 6.047/2007. Esta metodologia definiu as seguintes tipologias: i) MRG de alta renda; ii) MRG de baixa renda; iii) MRG dinâmica; e iv) MRG estagnada. O resultado indica uma grande alteração na classificação das MRGs. Conforme apresentado, 207 das 557 MRGs tiveram suas classificações alteradas com a atualização dos dados que parametrizam as tipologias da PNDR.},
  langid = {brazilian},
  keywords = {⛔ No DOI found},
  annotation = {Accepted: 2018-10-26T19:32:45Z},
  file = {/home/rodrigo/Zotero/storage/UDRFPUID/Macedo e Porto - 2018 - Proposta de atualização das tipologias da PNDR  nota metodológica e mapas de referência.pdf}
}

